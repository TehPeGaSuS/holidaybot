    "host": "irc.libera.chat",
    "nick": "pyxmasbot2",
    "channels": ["#test", "#test2"],
    "api_key": "your-locationiq-api-key",
    "sasl_nick": "pyxmasbot2",
    "sasl_pass": "hunter2"
  } */
]
