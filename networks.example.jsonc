// pyxmasbot --config networks.example.jsonc
// One entry per IRC network. Only host/nick/channels/api_key are required;
// everything else falls back to the same defaults as the CLI flags.
[
  {
    "host": "irc.ptirc.org",
    "nick": "pyxmasbot",
    "channels": ["##testchan"],
    "api_key": "your-locationiq-api-key"
  }
